ROADLABELOPS_ENV=development
ROADLABELOPS_PROJECT_DIR=.
ROADLABELOPS_DATA_DIR=./data
ROADLABELOPS_RUNTIME_DIR=./runtime
# Required only for final-holdout tooling; comma-separated positive IDs, with no defaults.
ROADLABELOPS_FINAL_HOLDOUT_TASK_IDS=
ROADLABELOPS_FINAL_HOLDOUT_JOB_IDS=
ROADLABELOPS_CORS_ORIGINS=http://localhost:3100
ROADLABELOPS_MAX_UPLOAD_BYTES=2147483648
ROADLABELOPS_UPLOAD_OVERHEAD_BYTES=1048576
ROADLABELOPS_MAX_VIDEO_DURATION_SECONDS=300
ROADLABELOPS_ABSOLUTE_MAX_VIDEO_DURATION_SECONDS=7200
ROADLABELOPS_MAX_SCENE_COUNT=720
ROADLABELOPS_MAX_SPLIT_OUTPUT_BYTES=8589934592
ROADLABELOPS_MAX_VIDEO_WIDTH=3840
ROADLABELOPS_MAX_VIDEO_HEIGHT=2160
ROADLABELOPS_MAX_VIDEO_FPS=60
CVAT_HOST=http://localhost:8080
CVAT_USERNAME=
CVAT_PASSWORD=
CVAT_ACCESS_TOKEN=
DETECTION_PROVIDER=yolo
DETECTION_MODEL=./yolo11n.pt
DETECTION_CONFIDENCE=0.40
DETECTION_NMS_IOU=0.75
DETECTION_RIDER_OVERLAP=0.25
NEXT_PUBLIC_API_BASE_URL=http://localhost:8100/api/v1
NEXT_PUBLIC_CVAT_BASE_URL=http://localhost:8080
NEXT_PUBLIC_SOURCE_URL=https://github.com/lzhaoyang658-ai/roadlabelops
