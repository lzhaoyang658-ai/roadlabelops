# BACKEND_URL and NEXT_PUBLIC_* values are embedded by `next build`.
# Rebuild the standalone frontend after changing them.
BACKEND_URL=http://localhost:8100
NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_CVAT_BASE_URL=http://localhost:8080
NEXT_PUBLIC_SOURCE_URL=https://github.com/lzhaoyang658-ai/roadlabelops

# Must match the backend upload ceiling. Next 16 accepts b, kb, mb, or gb units.
NEXT_PROXY_CLIENT_MAX_BODY_SIZE=2gb
